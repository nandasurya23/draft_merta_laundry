# ==========================================
# MERTA LAUNDRY - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit .env.local or sensitive credentials to Git.

# ------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Local development default:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/merta_laundry

# ------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------
# Secret key for JWT session tokens (HS256).
# IMPORTANT: In production, generate a cryptographically strong 32+ character key:
#   openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-minimum-32-characters

# ------------------------------------------
# 3. ENVIRONMENT
# ------------------------------------------
# Values: development | production | test
NODE_ENV=development
